# Container parameters for docker-compose. Copy this file to `.env` and adjust.
# Compose passes these to the container as environment variables; the image
# entrypoint converts them into CLI arguments for ipa-renamer.
IPA_RENAMER_WATCH=1
IPA_RENAMER_INPUT=/app/in
IPA_RENAMER_OUTPUT=/app/out
IPA_RENAMER_TIME=5
