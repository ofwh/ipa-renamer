# 宿主机输入目录（相对本目录），只用于 volumes 挂载到容器 /app/in，不进 environment
INPUT_DIR=./watched

# 宿主机输出目录（相对本目录），只用于 volumes 挂载到容器 /app/out，不进 environment
OUTPUT_DIR=./output

# 以下为容器环境变量，缺省值见 Dockerfile；WATCH、RECURSIVE、VERBOSE 在 docker-compose.yml
# 中默认注释，需要覆盖时取消对应行的注释

# 传入容器的 watch 防抖秒数，对应 -t；须为正整数，仅在 WATCH 开启时生效
IDLE_TIMEOUT=5

# 控制是否给 ipa-renamer 传 -w；只能为 0 或 1，缺省 1（即默认传 -w）
WATCH=0

# 控制是否给 ipa-renamer 传 -v；只能为 0 或 1，缺省 0
VERBOSE=1

# 控制是否给 ipa-renamer 传 -r；只能为 0 或 1，缺省 1（即默认传 -r，递归处理子目录）
RECURSIVE=0
